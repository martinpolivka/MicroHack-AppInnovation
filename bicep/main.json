          ],
          "secrets": [
            {
              "name": "database-password",
              "value": "[parameters('administratorLoginPassword')]"
            },
            {
              "name": "performance-api-key",
              "value": "[parameters('performanceApiKey')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "catalog",
              "image": "[format('{0}/{1}', reference('containerRegistry').loginServer, parameters('containerImageName'))]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "CATALOG_DATABASE_HOST",
                  "value": "[reference('postgresqlServer').fullyQualifiedDomainName]"
                },
                {
                  "name": "CATALOG_DATABASE_PORT",
                  "value": "5432"
                },
                {
                  "name": "CATALOG_DATABASE_NAME",
                  "value": "postgres"
                },
                {
                  "name": "CATALOG_DATABASE_USERNAME",
                  "value": "[parameters('administratorLogin')]"
                },
                {
                  "name": "CATALOG_DATABASE_PASSWORD",
                  "secretRef": "database-password"
                },
                {
                  "name": "CATALOG_DATABASE_SSL_MODE",
                  "value": "require"
                },
                {
                  "name": "CATALOG_IMAGES_PATH",
                  "value": "/mnt/images"
                },
                {
                  "name": "CATALOG_SEED_PATH",
                  "value": "/mnt/seed/catalog.json"
                },
                {
                  "name": "PERFTEST_API_KEY",
                  "secretRef": "performance-api-key"
                },
                {
                  "name": "OTEL_SERVICE_VERSION",
                  "value": "[parameters('containerImageName')]"
                },
                {
                  "name": "DEPLOYMENT_ENVIRONMENT",
                  "value": "lab"
                },
                {
                  "name": "OTEL_METRICS_EXPORTER",
                  "value": "none"
                }
              ],
              "volumeMounts": [
                {
                  "volumeName": "seed-volume",
                  "mountPath": "/mnt/seed"
                },
                {
                  "volumeName": "images-volume",
                  "mountPath": "/mnt/images"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 3,
            "rules": [
              {
                "name": "http-scaling-rule",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          },
          "volumes": [
            {
              "name": "seed-volume",
              "storageType": "AzureFile",
              "storageName": "seed-storage"
            },
            {
              "name": "images-volume",
              "storageType": "AzureFile",
              "storageName": "images-storage"
            }
          ]
        }
      },
      "dependsOn": [
        "acrPullRoleAssignment",
        "containerAppIdentity",
        "containerRegistry",
        "imagesEnvironmentStorage",
        "managedEnvironment",
        "postgresqlServer",
        "seedEnvironmentStorage"
      ]
    },
